<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="PersonalRAG"
        Arguments=""
        InstallLocation="C:\Program Files\PersonalRAG\PersonalRAG">
    </Installer>
    <PackageInformation
        PackageName="PersonalRAG"
        PackageDisplayName="PersonalRAG"
        PublisherName="CN=PersonalRAG"
        PublisherDisplayName="PersonalRAG"
        Version="0.1.0.0"
        PackageDescription="Lokale Dokumentensuche mit belegten Antworten">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dbis.kus.personalrag"
                Description="Lokale Dokumentensuche mit belegten Antworten"
                DisplayName="PersonalRAG"
                ExecutableName="PersonalRAG"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>PersonalRAG</DisplayName>
            <PublisherDisplayName>PersonalRAG</PublisherDisplayName>
            <Description>Lokale Dokumentensuche mit belegten Antworten</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="PersonalRAG.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
